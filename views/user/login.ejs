<% layout('./layouts/boilerplate') -%>
    <h3 style="margin-top: 5px">Login into WonderLust</h3>
    <div class="row">
        <div class="col-8 offset-2">
            <form action="/login" method="POST" novalidate class="needs-validation">
                <div class="mb-3">
                    <label for="title" class="form-label">User name</label>
                    <input type="text" placeholder="enter the user name" name="username" class="form-control" required />
                </div>

            
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" placeholder="enter password" name="password" class="form-control" required />
                </div>

                <button class="btn btn-success">Login</button>
            </form>
        </div>
    </div>